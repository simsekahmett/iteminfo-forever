<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
  <!-- A star on the world map where a creature that drops a wishlist item is,
       its mixin is in MapPins.lua -->
  <Frame name="ItemInfoMapPinTemplate" mixin="ItemInfoMapPinMixin" virtual="true" enableMouse="true">
    <Size x="18" y="18"/>
    <Layers>
      <Layer level="OVERLAY">
        <Texture parentKey="Icon" file="Interface\TargetingFrame\UI-RaidTargetingIcon_1" setAllPoints="true"/>
      </Layer>
      <Layer level="HIGHLIGHT">
        <Texture file="Interface\TargetingFrame\UI-RaidTargetingIcon_1" alphaMode="ADD" setAllPoints="true"/>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad method="OnLoad"/>
      <OnEnter method="OnMouseEnter"/>
      <OnLeave method="OnMouseLeave"/>
    </Scripts>
  </Frame>
</Ui>
